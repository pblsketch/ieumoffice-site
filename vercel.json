{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ieumoffice.com"
        }
      ],
      "destination": "https://ieumoffice.com/:path*",
      "permanent": true
    },
    {
      "source": "/((?!privacy\\.html$|form-banner\\.png$|google8ab101bc93526a97\\.html$).*)",
      "has": [
        {
          "type": "host",
          "value": "ieumoffice.vercel.app"
        }
      ],
      "destination": "https://ieumoffice.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/updates",
      "destination": "/updates.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/shots/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
