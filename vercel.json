{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ieumoffice.com"
        }
      ],
      "destination": "https://ieumoffice.com/:path*",
      "permanent": true
    },
    {
      "source": "/((?!privacy\\.html$|form-banner\\.png$|og\\.png$|google8ab101bc93526a97\\.html$).*)",
      "has": [
        {
          "type": "host",
          "value": "ieumoffice.vercel.app"
        }
      ],
      "destination": "https://ieumoffice.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/updates",
      "destination": "/updates.html"
    },
    {
      "source": "/story",
      "destination": "/story.html"
    },
    {
      "source": "/install",
      "destination": "/install.html"
    },
    {
      "source": "/connect",
      "destination": "/connect.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/shots/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/:file(favicon\\.ico|favicon\\.svg|favicon-48\\.png|favicon-96\\.png|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png|og\\.png|form-banner\\.png|site\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/:file(robots\\.txt|sitemap\\.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/ask.js": {
      "maxDuration": 60
    }
  }
}
